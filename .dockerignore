# Build context hygiene — keep the image build fast and leak-free.

# Local config generated by the proxy (never bake it into the image).
zen-proxy.json

# Runtime inputs are copied explicitly in the Dockerfile; skip the rest of the
# repo so the build context stays small.
node_modules
npm-debug.log
test
scripts
bin
install.sh
install.ps1
assets
LICENSE
llms.txt
llms-full.txt

# VCS / lockfiles
.git
.github
*.lock

# Docker build files (not part of the image)
Dockerfile
docker-compose*.yml
.dockerignore
